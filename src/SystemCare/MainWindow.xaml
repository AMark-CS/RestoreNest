<Window x:Class="SystemCare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RestoreNest" Width="1000" Height="690" MinWidth="740" MinHeight="500" Background="#F4F7FB" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="130" SelectedIndex="0" SelectionChanged="LanguageChanged"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="RestoreNest" FontSize="27" FontWeight="SemiBold" Foreground="#17233B"/></DockPanel>
    <TextBlock Grid.Row="1" x:Name="Intro" Foreground="#58677F" Margin="0,0,0,18" TextWrapping="Wrap"/>
    <TabControl Grid.Row="2" x:Name="Tabs">
      <TabItem x:Name="AppsTab"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><TextBox x:Name="Search" Padding="10" TextChanged="SearchChanged"/></DockPanel>
        <ListView x:Name="AppList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Width="45"><GridViewColumn.CellTemplate><DataTemplate><CheckBox AutomationProperties.Name="{Binding App.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn x:Name="NameColumn" DisplayMemberBinding="{Binding App.Name}" Width="260"/><GridViewColumn x:Name="PublisherColumn" DisplayMemberBinding="{Binding App.Publisher}" Width="210"/><GridViewColumn x:Name="VersionColumn" DisplayMemberBinding="{Binding App.Version}" Width="130"/><GridViewColumn x:Name="SizeColumn" DisplayMemberBinding="{Binding SizeText}" Width="90"/></GridView></ListView.View></ListView>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="UninstallButton" DockPanel.Dock="Right" Padding="14,8" Margin="12,0,0,0" Click="UninstallClick"/><Button x:Name="ReviewButton" DockPanel.Dock="Right" Padding="14,8" Margin="12,0,0,0" Click="ReviewClick"/><StackPanel><TextBlock x:Name="SelectionCount" Margin="0,0,0,4"/><TextBlock x:Name="AppsNotice" Foreground="#6D5B35" TextWrapping="Wrap"/></StackPanel></DockPanel>
      </Grid></TabItem>
      <TabItem x:Name="DisksTab"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshDisksButton" DockPanel.Dock="Right" Padding="14,8" Click="RefreshDisksClick"/><TextBlock x:Name="DisksTitle" FontSize="21" FontWeight="SemiBold"/></DockPanel>
        <ListView x:Name="DiskList" Grid.Row="1"><ListView.View><GridView><GridViewColumn x:Name="DiskNameColumn" DisplayMemberBinding="{Binding Display}" Width="170"/><GridViewColumn x:Name="DiskFormatColumn" DisplayMemberBinding="{Binding Format}" Width="80"/><GridViewColumn x:Name="DiskUsageColumn" Width="220"><GridViewColumn.CellTemplate><DataTemplate><ProgressBar Width="200" Height="14" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" AutomationProperties.Name="{Binding Summary}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn x:Name="DiskUsedColumn" DisplayMemberBinding="{Binding Summary}" Width="180"/><GridViewColumn x:Name="DiskFreeColumn" DisplayMemberBinding="{Binding FreeText}" Width="100"/></GridView></ListView.View></ListView>
      </Grid></TabItem>
      <TabItem x:Name="RestorePointsTab"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
        <TextBlock x:Name="RpTitle" FontSize="21" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="RpPathLabel" Margin="0,0,0,6" TextWrapping="Wrap"/><DockPanel><Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" Content="…" Click="RpBrowseClick" AutomationProperties.Name="Browse"/><TextBox x:Name="RpPath" Text="D:\" Padding="8" AutomationProperties.LabeledBy="{Binding ElementName=RpPathLabel}"/></DockPanel></StackPanel>
        <DockPanel Grid.Row="2" Margin="0,10,0,0"><TextBox x:Name="RpName" Width="220" Padding="8" DockPanel.Dock="Right" AutomationProperties.Name="Restore point name"/><WrapPanel><Button x:Name="RpCreateButton" Padding="12,7" Margin="0,0,8,0" Click="RpCreateClick"/><Button x:Name="RpRefreshButton" Padding="12,7" Margin="0,0,8,0" Click="RpRefreshClick"/><Button x:Name="RpVerifyButton" Padding="12,7" Margin="0,0,8,0" Click="RpVerifyClick"/><Button x:Name="RpInstallBootButton" Padding="12,7" Margin="0,0,8,0" Click="RpInstallBootClick"/><Button x:Name="RpRemoveBootButton" Padding="12,7" Click="RpRemoveBootClick"/></WrapPanel></DockPanel>
        <StackPanel Grid.Row="3"><ProgressBar x:Name="RpProgress" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="RpNotice" Foreground="#6D5B35" TextWrapping="Wrap" Margin="0,10,0,6"/></StackPanel>
        <ListView x:Name="RpList" Grid.Row="4"><ListView.View><GridView><GridViewColumn x:Name="RpIdColumn" DisplayMemberBinding="{Binding Id}" Width="150"/><GridViewColumn x:Name="RpNameColumn" DisplayMemberBinding="{Binding Name}" Width="220"/><GridViewColumn x:Name="RpCreatedColumn" DisplayMemberBinding="{Binding Created}" Width="150"/><GridViewColumn x:Name="RpSizeColumn" DisplayMemberBinding="{Binding SizeText}" Width="90"/><GridViewColumn x:Name="RpStatusColumn" DisplayMemberBinding="{Binding Status}" Width="220"/></GridView></ListView.View></ListView>
        <TextBox Grid.Row="5" x:Name="RpOutput" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Output"/>
      </Grid></TabItem>
      <TabItem x:Name="BackupTab" AutomationProperties.AutomationId="BackupTab"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="BackupTitle" FontSize="21" FontWeight="SemiBold"/><StackPanel Grid.Row="1"><TextBlock x:Name="PathLabel" Margin="0,20,0,8"/><DockPanel><Button x:Name="Browse" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,8" Click="BrowseClick"/><TextBox x:Name="BackupPath" AutomationProperties.AutomationId="BackupPath" Padding="8" Text="D:\" TextChanged="PathChanged" AutomationProperties.LabeledBy="{Binding ElementName=PathLabel}"/></DockPanel><TextBlock x:Name="PathStatus" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Row="2" x:Name="BackupNotice" Margin="0,20,0,0" Foreground="#6D5B35" TextWrapping="Wrap"/><Button Grid.Row="3" x:Name="StartBackupButton" AutomationProperties.AutomationId="StartBackupButton" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8" Click="StartBackupClick"/><ProgressBar Grid.Row="4" x:Name="BackupProgress" AutomationProperties.AutomationId="BackupProgress" Height="8" Margin="0,16,0,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBox Grid.Row="5" x:Name="BackupOutput" AutomationProperties.AutomationId="BackupOutput" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
      <TabItem x:Name="RecoveryTab"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="RecoveryNotice" TextWrapping="Wrap" FontSize="15"/><DockPanel Grid.Row="1" Margin="0,16,0,8"><Button x:Name="CatalogButton" DockPanel.Dock="Right" Padding="14,8" Margin="8,0,0,0" Click="CatalogClick"/><TextBox x:Name="CatalogDrive" Text="D:\" Padding="8" TextChanged="CatalogDriveChanged"/></DockPanel><StackPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock x:Name="RecoveryVersionsLabel" Margin="0,0,0,4"/><ComboBox x:Name="RecoveryVersions" Padding="8" AutomationProperties.LabeledBy="{Binding ElementName=RecoveryVersionsLabel}"/><Button x:Name="ExportRecoveryButton" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,8" Click="ExportRecoveryClick"/></StackPanel><TextBox Grid.Row="3" x:Name="CatalogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="4" x:Name="VerifyButton" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,8" Click="VerifyClick"/><TextBlock Grid.Row="5" x:Name="VerifyStatus" Margin="0,8,0,0" TextWrapping="Wrap"/></Grid></TabItem>
    </TabControl>
  </Grid>
</Window>
