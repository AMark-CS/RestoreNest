<Window x:Class="SystemCare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RestoreNest" Width="1120" Height="740" MinWidth="860" MinHeight="560" Background="{StaticResource PageBg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24,16,18">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,28" Orientation="Horizontal">
          <Viewbox Width="38" Height="38">
            <Canvas Width="256" Height="256">
              <Border Width="256" Height="256" CornerRadius="58"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4F86FF" Offset="0"/><GradientStop Color="#1F4FD8" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Path Data="M175.6,71.3 A74,74 0 1 1 80.4,71.3" Stroke="White" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Polygon Points="103,52 85,86 62,66" Fill="White" Stroke="White" StrokeThickness="6" StrokeLineJoin="Round"/>
              <Ellipse Canvas.Left="109" Canvas.Top="87" Width="38" Height="50" Fill="#CFE0FF"/>
              <Path Data="M78,124 Q128,214 178,124 Q128,144 78,124 Z" Fill="White" Stroke="White" StrokeThickness="8" StrokeLineJoin="Round"/>
              <Path Data="M92,142 Q128,160 164,142 M104,158 Q128,172 152,158" Stroke="#2A5BE8" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Viewbox>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="RestoreNest" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Tagline" FontSize="11" Foreground="{StaticResource InkSoft}"/></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="LanguageButton" Margin="0,0,0,10" Padding="12,7" Click="LanguageClick" AutomationProperties.Name="Language"/>
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="2,0,0,0"/>
        </StackPanel>
        <StackPanel>
          <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" Tag="&#xE777;" IsChecked="True" GroupName="nav" Checked="NavChanged"/>
          <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="&#xE71D;" GroupName="nav" Checked="NavChanged"/>
          <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Tag="&#xEDA2;" GroupName="nav" Checked="NavChanged"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pages -->
    <Grid Grid.Column="1" Margin="32,26,32,24">

      <!-- Restore points -->
      <ScrollViewer x:Name="RestorePage" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="RpTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="RpSubtitle" Foreground="{StaticResource InkSoft}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1">
        <Border x:Name="RpEnvCard" Style="{StaticResource Card}" Margin="0,0,0,14">
          <DockPanel>
            <Button x:Name="RpInstallBootButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="20,9" VerticalAlignment="Center" Click="RpInstallBootClick"/>
            <Button x:Name="RpRecoverNowButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="20,9" VerticalAlignment="Center" Click="RpRecoverNowClick" Visibility="Collapsed"/>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="RpEnvTitle" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="RpEnvStatus" FontSize="12.5" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
          </DockPanel>
        </Border>
        <Border x:Name="RpBitLockerCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RpKeyShowButton" Padding="14,8" Margin="12,0,0,0" Click="RpKeyShowClick"/>
              <Button x:Name="RpKeySaveButton" Padding="14,8" Margin="8,0,0,0" Click="RpKeySaveClick"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="RpBitLockerTitle" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="RpBitLockerText" FontSize="12.5" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="RpPathLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="…" Padding="14,8" Click="RpBrowseClick" AutomationProperties.Name="Browse"/>
              <TextBox x:Name="RpPath" Text="D:\" AutomationProperties.LabeledBy="{Binding ElementName=RpPathLabel}" TextChanged="RpPathChanged"/>
            </DockPanel>
            <TextBlock x:Name="RpPathHint" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,6,0,0" TextWrapping="Wrap"/>
            <DockPanel Margin="0,14,0,0">
              <Button x:Name="RpCreateButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="22,9" Click="RpCreateClick"/>
              <TextBox x:Name="RpName" AutomationProperties.Name="Restore point name"/>
            </DockPanel>
            <ProgressBar x:Name="RpProgress" Style="{x:Null}" Height="6" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <CheckBox x:Name="AutoEnabled" FontWeight="SemiBold" FontSize="14" Checked="AutoEnabledChanged" Unchecked="AutoEnabledChanged"/>
            <TextBlock x:Name="AutoHint" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="22,4,0,0" TextWrapping="Wrap"/>
            <WrapPanel x:Name="AutoOptions" Margin="0,12,0,0">
              <StackPanel Margin="0,0,16,8"><TextBlock x:Name="AutoFrequencyLabel" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,0,0,4"/><ComboBox x:Name="AutoFrequency" MinWidth="130" SelectionChanged="AutoFrequencyChanged" AutomationProperties.LabeledBy="{Binding ElementName=AutoFrequencyLabel}"/></StackPanel>
              <StackPanel x:Name="AutoDayPanel" Margin="0,0,16,8"><TextBlock x:Name="AutoDayLabel" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,0,0,4"/><ComboBox x:Name="AutoDay" SelectionChanged="AutoOptionChanged" MinWidth="110" AutomationProperties.LabeledBy="{Binding ElementName=AutoDayLabel}"/></StackPanel>
              <StackPanel x:Name="AutoMonthPanel" Margin="0,0,16,8"><TextBlock x:Name="AutoMonthLabel" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,0,0,4"/><ComboBox x:Name="AutoMonthDay" SelectionChanged="AutoOptionChanged" MinWidth="90" AutomationProperties.LabeledBy="{Binding ElementName=AutoMonthLabel}"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock x:Name="AutoTimeLabel" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,0,0,4"/><ComboBox x:Name="AutoTime" SelectionChanged="AutoOptionChanged" MinWidth="90" AutomationProperties.LabeledBy="{Binding ElementName=AutoTimeLabel}"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock x:Name="AutoKeepLabel" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="2,0,0,4"/><ComboBox x:Name="AutoKeep" SelectionChanged="AutoOptionChanged" MinWidth="130" AutomationProperties.LabeledBy="{Binding ElementName=AutoKeepLabel}"/></StackPanel>
              <CheckBox x:Name="AutoOnlyAc" Checked="AutoOptionChanged" Unchecked="AutoOptionChanged" VerticalAlignment="Bottom" Margin="0,0,16,14"/>
            </WrapPanel>
            <DockPanel Margin="0,4,0,0">
              <Button x:Name="AutoSaveButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="18,8" Click="AutoSaveClick"/>
              <TextBlock x:Name="AutoStatus" FontSize="12.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" x:Name="RpBanner" Background="{StaticResource WarnBg}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"><TextBlock x:Name="RpNotice" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12.5"/></Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Height="300">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="18,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <DockPanel>
                <WrapPanel DockPanel.Dock="Right"><Button x:Name="RpRefreshButton" Margin="0,0,8,0" Padding="12,6" Click="RpRefreshClick"/><Button x:Name="RpVerifyButton" Margin="0,0,8,0" Padding="12,6" Click="RpVerifyClick"/><Button x:Name="RpRemoveBootButton" Padding="12,6" Click="RpRemoveBootClick"/></WrapPanel>
                <TextBlock x:Name="RpListTitle" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Grid>
              <ListView x:Name="RpList" Margin="6,0"><ListView.View><GridView><GridViewColumn x:Name="RpIdColumn" DisplayMemberBinding="{Binding Id}" Width="150"/><GridViewColumn x:Name="RpNameColumn" DisplayMemberBinding="{Binding Name}" Width="220"/><GridViewColumn x:Name="RpCreatedColumn" DisplayMemberBinding="{Binding Created}" Width="150"/><GridViewColumn x:Name="RpSizeColumn" DisplayMemberBinding="{Binding SizeText}" Width="90"/><GridViewColumn x:Name="RpStatusColumn" DisplayMemberBinding="{Binding Status}" Width="140"/></GridView></ListView.View></ListView>
              <TextBlock x:Name="RpEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed"/>
            </Grid>
          </DockPanel>
        </Border>
        <Expander Grid.Row="5" x:Name="RpLogExpander" Margin="0,12,0,0" IsExpanded="False"><TextBox x:Name="RpOutput" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Output"/></Expander>
      </Grid>
      </ScrollViewer>

      <!-- Apps -->
      <Grid x:Name="AppsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="AppsTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="AppsSubtitle" Foreground="{StaticResource InkSoft}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="Search" TextChanged="SearchChanged" Padding="38,9,10,9" AutomationProperties.Name="Search apps"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource InkSoft}" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/></Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <ListView x:Name="AppList" Margin="6,0"><ListView.View><GridView><GridViewColumn Width="46"><GridViewColumn.CellTemplate><DataTemplate><CheckBox Margin="14,0,0,0" AutomationProperties.Name="{Binding App.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn x:Name="NameColumn" DisplayMemberBinding="{Binding App.Name}" Width="300"/><GridViewColumn x:Name="PublisherColumn" DisplayMemberBinding="{Binding App.Publisher}" Width="200"/><GridViewColumn x:Name="VersionColumn" DisplayMemberBinding="{Binding App.Version}" Width="120"/><GridViewColumn x:Name="SizeColumn" DisplayMemberBinding="{Binding SizeText}" Width="90"/></GridView></ListView.View></ListView>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
          <Button x:Name="UninstallButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Padding="20,9" Margin="10,0,0,0" Click="UninstallClick"/>
          <Button x:Name="ReviewButton" DockPanel.Dock="Right" Padding="16,9" Click="ReviewClick"/>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectionCount" FontWeight="SemiBold"/><TextBlock x:Name="AppsNotice" FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,2,16,0"/></StackPanel>
        </DockPanel>
      </Grid>

      <!-- Disks -->
      <Grid x:Name="DisksPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
          <Button x:Name="RefreshDisksButton" DockPanel.Dock="Right" VerticalAlignment="Top" Click="RefreshDisksClick"/>
          <StackPanel><TextBlock x:Name="DisksTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DisksSubtitle" Foreground="{StaticResource InkSoft}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DiskList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Display}" FontSize="16" FontWeight="SemiBold"/><Border Background="#EEF1F6" CornerRadius="5" Padding="7,1" Margin="10,2,0,0"><TextBlock Text="{Binding Format}" FontSize="11" Foreground="{StaticResource InkSoft}"/></Border></StackPanel>
                      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,10,0,8" AutomationProperties.Name="{Binding Summary}"/>
                      <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{StaticResource InkSoft}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="20,0,0,0"><TextBlock Text="{Binding FreeText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding FreeLabel}" FontSize="11.5" Foreground="{StaticResource InkSoft}" HorizontalAlignment="Right"/></StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCritical}" Value="True"><Setter TargetName="Bar" Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
