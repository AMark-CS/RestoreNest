<Window x:Class="SystemCare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RestoreNest" Width="1000" Height="690" MinWidth="740" MinHeight="500" Background="#F4F7FB" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="130" SelectedIndex="0" SelectionChanged="LanguageChanged"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="RestoreNest" FontSize="27" FontWeight="SemiBold" Foreground="#17233B"/></DockPanel>
    <TextBlock Grid.Row="1" x:Name="Intro" Foreground="#58677F" Margin="0,0,0,18" TextWrapping="Wrap"/>
    <TabControl Grid.Row="2" x:Name="Tabs">
      <TabItem x:Name="AppsTab"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><CheckBox x:Name="QihooFilter" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Checked="QihooFilterChanged" Unchecked="QihooFilterChanged"/><TextBox x:Name="Search" Padding="10" TextChanged="SearchChanged"/></DockPanel>
        <ListView x:Name="AppList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Width="45"><GridViewColumn.CellTemplate><DataTemplate><CheckBox AutomationProperties.Name="{Binding App.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn x:Name="NameColumn" DisplayMemberBinding="{Binding App.Name}" Width="260"/><GridViewColumn x:Name="PublisherColumn" DisplayMemberBinding="{Binding App.Publisher}" Width="210"/><GridViewColumn x:Name="VersionColumn" DisplayMemberBinding="{Binding App.Version}" Width="140"/></GridView></ListView.View></ListView>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="ReviewButton" DockPanel.Dock="Right" Padding="14,8" Margin="12,0,0,0" Click="ReviewClick"/><StackPanel><TextBlock x:Name="SelectionCount" Margin="0,0,0,4"/><TextBlock x:Name="AppsNotice" Foreground="#6D5B35" TextWrapping="Wrap"/></StackPanel></DockPanel>
      </Grid></TabItem>
      <TabItem x:Name="BackupTab" AutomationProperties.AutomationId="BackupTab"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="BackupTitle" FontSize="21" FontWeight="SemiBold"/><StackPanel Grid.Row="1"><TextBlock x:Name="PathLabel" Margin="0,20,0,8"/><DockPanel><Button x:Name="Browse" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,8" Click="BrowseClick"/><TextBox x:Name="BackupPath" AutomationProperties.AutomationId="BackupPath" Padding="8" Text="D:\" TextChanged="PathChanged" AutomationProperties.LabeledBy="{Binding ElementName=PathLabel}"/></DockPanel><TextBlock x:Name="PathStatus" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Row="2" x:Name="BackupNotice" Margin="0,20,0,0" Foreground="#6D5B35" TextWrapping="Wrap"/><Button Grid.Row="3" x:Name="StartBackupButton" AutomationProperties.AutomationId="StartBackupButton" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8" Click="StartBackupClick"/><ProgressBar Grid.Row="4" x:Name="BackupProgress" AutomationProperties.AutomationId="BackupProgress" Height="8" Margin="0,16,0,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBox Grid.Row="5" x:Name="BackupOutput" AutomationProperties.AutomationId="BackupOutput" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
      <TabItem x:Name="RecoveryTab"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="RecoveryNotice" TextWrapping="Wrap" FontSize="15"/><DockPanel Grid.Row="1" Margin="0,16,0,8"><Button x:Name="CatalogButton" DockPanel.Dock="Right" Padding="14,8" Margin="8,0,0,0" Click="CatalogClick"/><TextBox x:Name="CatalogDrive" Text="D:\" Padding="8" TextChanged="CatalogDriveChanged"/></DockPanel><StackPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock x:Name="RecoveryVersionsLabel" Margin="0,0,0,4"/><ComboBox x:Name="RecoveryVersions" Padding="8" AutomationProperties.LabeledBy="{Binding ElementName=RecoveryVersionsLabel}"/><Button x:Name="ExportRecoveryButton" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,8" Click="ExportRecoveryClick"/></StackPanel><TextBox Grid.Row="3" x:Name="CatalogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="4" x:Name="VerifyButton" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,8" Click="VerifyClick"/><TextBlock Grid.Row="5" x:Name="VerifyStatus" Margin="0,8,0,0" TextWrapping="Wrap"/></Grid></TabItem>
    </TabControl>
  </Grid>
</Window>
